-- Panda Hub - Keyboard Simulator Fake Infinite Level + Sound
local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local LP = Players.LocalPlayer

if CoreGui:FindFirstChild("PandaKeyboardHub") then CoreGui.PandaKeyboardHub:Destroy() end

local ScreenGui = Instance.new("ScreenGui", CoreGui)
ScreenGui.Name = "PandaKeyboardHub"

local MainFrame = Instance.new("Frame", ScreenGui)
MainFrame.Size = UDim2.new(0, 240, 0, 200)
MainFrame.Position = UDim2.new(0.35, 0, 0.3, 0)
MainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
MainFrame.Active = true
MainFrame.Draggable = true

local UICorner = Instance.new("UICorner", MainFrame)
UICorner.CornerRadius = UDim.new(0, 12)

local UIStroke = Instance.new("UIStroke", MainFrame)
UIStroke.Color = Color3.fromRGB(0, 200, 255)
UIStroke.Thickness = 2

-- شريط العنوان
local TopBar = Instance.new("Frame", MainFrame)
TopBar.Size = UDim2.new(1, 0, 0, 35)
TopBar.BackgroundColor3 = Color3.fromRGB(0, 120, 200)
TopBar.Parent = MainFrame
Instance.new("UICorner", TopBar).CornerRadius = UDim.new(0, 12)

local Title = Instance.new("TextLabel", TopBar)
Title.Size = UDim2.new(1, 0, 1, 0)
Title.BackgroundTransparency = 1
Title.Text = "Panda Hub - Keyboard Sim 🐼"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.Font = Enum.Font.SourceSansBold
Title.TextSize = 13

local CloseBtn = Instance.new("TextButton", TopBar)
CloseBtn.Size = UDim2.new(0, 25, 0, 25)
CloseBtn.Position = UDim2.new(0.88, 0, 0.15, 0)
CloseBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
CloseBtn.Text = "X"
CloseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
Instance.new("UICorner", CloseBtn).CornerRadius = UDim.new(0, 6)
CloseBtn.MouseButton1Click:Connect(function() ScreenGui:Destroy() end)

-- زر اللفل اللانهائي الشكلي
local LevelBtn = Instance.new("TextButton", MainFrame)
LevelBtn.Size = UDim2.new(0.85, 0, 0, 50)
LevelBtn.Position = UDim2.new(0.075, 0, 0.35, 0)
LevelBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
LevelBtn.Text = "ألفل الانهائي (Infinite Level): [ طافٍ ]"
LevelBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
LevelBtn.Font = Enum.Font.SourceSansBold
LevelBtn.TextSize = 13
Instance.new("UICorner", LevelBtn).CornerRadius = UDim.new(0, 8)

-- إنشاء صوت اللفل (Level Up Sound)
local sound = Instance.new("Sound")
sound.SoundId = "rbxassetid://4590657391" -- صوت نجاح / لفل أب رسمي من روبلوكس
sound.Volume = 0.5
sound.Parent = CoreGui

-- برمجة اللفل الوهمي مع تشغيل الصوت
local fakeLevelActive = false
local currentFakeLevel = 5000

LevelBtn.MouseButton1Click:Connect(function()
    fakeLevelActive = not fakeLevelActive
    if fakeLevelActive then
        LevelBtn.Text = "ألفل الانهائي (Infinite Level): [ شغال ✓ ]"
        LevelBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 220)
        
        task.spawn(function()
            while fakeLevelActive do
                currentFakeLevel = currentFakeLevel + 1
                
                -- تشغيل صوت اللفل كل عدة لفلات عشان ما يصير مزعج
                pcall(function()
                    sound:Play()
                end)
                
                pcall(function()
                    local playerGui = LP:FindFirstChild("PlayerGui")
                    if playerGui then
                        for _, gui in pairs(playerGui:GetDescendants()) do
                            if gui:IsA("TextLabel") and (string.find(string.lower(gui.Text), "level") or string.find(string.lower(gui.Text), "lvl") or string.find(string.lower(gui.Text), "lev")) then
                                gui.Text = "Level: " .. tostring(currentFakeLevel)
                            end
                        end
                    end
                end)
                task.wait(0.5) -- سرعة أبطأ شوي عشان يمديك تسمع الصوت وتستمتع بالحركة
            end
        end)
    else
        LevelBtn.Text = "ألفل الانهائي (Infinite Level): [ طافٍ ]"
        LevelBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    end
end)
