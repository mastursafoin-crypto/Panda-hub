-- دالة التغيير الشاملة
local function applyAnimationPack(ids)
    local char = LP.Character
    if not char then return end
    local animate = char:FindFirstChild("Animate")
    if animate then
        animate.Disabled = true
        for _, anim in pairs(animate:GetChildren()) do
            if anim:IsA("StringValue") then
                for name, id in pairs(ids) do
                    if anim.Name == name then
                        for _, child in pairs(anim:GetChildren()) do
                            if child:IsA("Animation") then
                                child.AnimationId = "rbxassetid://" .. tostring(id)
                            end
                        end
                    end
                end
            end
        end
        animate.Disabled = false
    end
end

