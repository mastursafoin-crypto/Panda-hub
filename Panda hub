    DiscordBtn.MouseButton1Click:Connect(function()
        pcall(function() setclipboard(DiscordLink) end)
        DiscordBtn.Text = "تم النسخ!"
        task.wait(1.5)
        DiscordBtn.Text = "رابط ديسكورد السيرفر"
    end)

    local function makeCharacterBig(char)
        local rootPart = char:WaitForChild("HumanoidRootPart", 5)
        if not rootPart then return end
        pcall(function()
            for _, part in ipairs(char:GetChildren()) do
                if part:IsA("BasePart") then
                    part.Size = part.Size * 1.5
                end
            end
        end)
    end

    TextButton.MouseButton1Click:Connect(function()
        if LP.Character then makeCharacterBig(LP.Character) end
    end)

    LP.CharacterAdded:Connect(function(newChar)
        task.wait(1.5)
        makeCharacterBig(newChar)
    end)
end

-- 3. جهاز الاستشعار والفحص الدائم (Auto-Check Sensor)
local hasJoined = false

JoinBtn.MouseButton1Click:Connect(function()
    pcall(function() setclipboard(DiscordLink) end)
    JoinBtn.Text = "تم نسخ الرابط! انضم وارجع للعبة..."
    
    -- حاول إرسال طلب انضمام تلقائي عبر المحاكي (Prompt Discord Invite)
    pcall(function()
        if request then
            request({
                Url = 'http://127.0.0.1:6463/rpc?v=1',
                Method = 'POST',
                Headers = {
                    ['Content-Type'] = 'application/json',
                    ['Origin'] = 'https://discord.com'
                },
                Body = HttpService:JSONEncode({
                    cmd = 'INVITE_BROWSER',
                    args = {code = DiscordInvite},
                    nonce = HttpService:GenerateGUID(false)
                })
            })
        end
    end)
end)

-- الحلقة التكرارية المسؤولة عن فتح السكربت تلقائياً بعد الفحص
task.spawn(function()
    while not hasJoined do
        task.wait(1.5)
        -- يقوم السكربت بفتح القائمة تلقائياً بمجرد إتمام التفاعل أو الانضمام
        if JoinBtn.Text:find("تم نسخ") then
            LockStatus.Text = "تم التحقق بنجاح! جاري فتح Panda Hub..."
            LockStatus.TextColor3 = Color3.fromRGB(100, 255, 100)
            task.wait(1)
            hasJoined = true
            LoadMainScript()
            break
        end
    end
end)

