-- Panda Hub - Fixed Character Reset & Forced Discord Script
local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local LP = Players.LocalPlayer

local DiscordInvite = "wb58RgSp"
local DiscordLink = "https://discord.gg/" .. DiscordInvite

if CoreGui:FindFirstChild("PandaHub") then CoreGui.PandaHub:Destroy() end
if CoreGui:FindFirstChild("PandaLock") then CoreGui.PandaLock:Destroy() end

-- 1. شاشة القفل والاستشعار
local LockGui = Instance.new("ScreenGui", CoreGui)
LockGui.Name = "PandaLock"

local LockFrame = Instance.new("Frame", LockGui)
LockFrame.Size = UDim2.new(0, 260, 0, 150)
LockFrame.Position = UDim2.new(0.5, -130, 0.5, -75)
LockFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
LockFrame.Active = true
LockFrame.Draggable = true

local LockCorner = Instance.new("UICorner", LockFrame)
LockCorner.CornerRadius = UDim.new(0, 12)

local LockStroke = Instance.new("UIStroke", LockFrame)
LockStroke.Thickness = 2
LockStroke.Color = Color3.fromRGB(255, 30, 30)

local LockTitle = Instance.new("TextLabel", LockFrame)
LockTitle.Size = UDim2.new(1, 0, 0, 35)
LockTitle.BackgroundTransparency = 1
LockTitle.Text = "Panda Hub - System Lock 🔒"
LockTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
LockTitle.Font = Enum.Font.SourceSansBold
LockTitle.TextSize = 16

local LockStatus = Instance.new("TextLabel", LockFrame)
LockStatus.Size = UDim2.new(0.9, 0, 0, 50)
LockStatus.Position = UDim2.new(0.05, 0, 0.25, 0)
LockStatus.BackgroundTransparency = 1
LockStatus.Text = "جاري التحقق من دخولك لسيرفر الديسكورد...\nيرجى الانضمام ليفتح السكربت تلقائياً!"
LockStatus.TextColor3 = Color3.fromRGB(200, 200, 200)
LockStatus.Font = Enum.Font.SourceSans
LockStatus.TextSize = 13
LockStatus.TextWrapped = true

local JoinBtn = Instance.new("TextButton", LockFrame)
JoinBtn.Size = UDim2.new(0.85, 0, 0, 35)
JoinBtn.Position = UDim2.new(0.075, 0, 0.68, 0)
JoinBtn.BackgroundColor3 = Color3.fromRGB(180, 20, 20)
JoinBtn.Text = "نسخ رابط السيرفر وتحقق"
JoinBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
JoinBtn.Font = Enum.Font.SourceSansBold
JoinBtn.TextSize = 14

local JoinCorner = Instance.new("UICorner", JoinBtn)
JoinCorner.CornerRadius = UDim.new(0, 8)

pcall(function()
    setclipboard(DiscordLink)
end)

-- 2. السكربت الرئيسي
local function LoadMainScript()
    if CoreGui:FindFirstChild("PandaLock") then CoreGui.PandaLock:Destroy() end

    local ScreenGui = Instance.new("ScreenGui")
    local MainFrame = Instance.new("Frame")
    local UICorner = Instance.new("UICorner")
    local TopBar = Instance.new("Frame")
    local Title = Instance.new("TextLabel")
    local CloseBtn = Instance.new("TextButton")
    local MinimizeBtn = Instance.new("TextButton")
    
    local TextButton = Instance.new("TextButton")
    local UICornerBtn = Instance.new("UICorner")
    
    local ResetBtn = Instance.new("TextButton")
    local UICornerReset = Instance.new("UICorner")
    
    local DiscordBtn = Instance.new("TextButton")
    local UICornerDiscord = Instance.new("UICorner")

    ScreenGui.Parent = CoreGui
    ScreenGui.Name = "PandaHub"

    MainFrame.Parent = ScreenGui
    MainFrame.BackgroundColor3 = Color3.fromRGB(180, 20, 20)
    MainFrame.Position = UDim2.new(0.3, 0, 0.3, 0)
    MainFrame.Size = UDim2.new(0, 220, 0, 230)
    MainFrame.Active = true
    MainFrame.Draggable = true

    UICorner.CornerRadius = UDim.new(0, 12)
    UICorner.Parent = MainFrame

    TopBar.Parent = MainFrame
    TopBar.BackgroundColor3 = Color3.fromRGB(140, 15, 15)
    TopBar.Size = UDim2.new(1, 0, 0, 35)
    local TopCorner = Instance.new("UICorner")
    TopCorner.CornerRadius = UDim.new(0, 12)
    TopCorner.Parent = TopBar

    Title.Parent = TopBar
    Title.BackgroundTransparency = 1
    Title.Position = UDim2.new(0.05, 0, 0, 0)
    Title.Size = UDim2.new(0.6, 0, 1, 0)
    Title.Font = Enum.Font.SourceSansBold
    Title.Text = "Panda Hub 🐼"
    Title.TextColor3 = Color3.fromRGB(255, 255, 255)
    Title.TextSize = 16
    Title.TextXAlignment = Enum.TextXAlignment.Left

    CloseBtn.Parent = TopBar
    CloseBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
    CloseBtn.Position = UDim2.new(0.82, 0, 0.15, 0)
    CloseBtn.Size = UDim2.new(0, 25, 0, 25)
    CloseBtn.Font = Enum.Font.SourceSansBold
    CloseBtn.Text = "X"
    CloseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    CloseBtn.TextSize = 14
    local CloseCorner = Instance.new("UICorner")
    CloseCorner.CornerRadius = UDim.new(0, 6)
    CloseCorner.Parent = CloseBtn

    CloseBtn.MouseButton1Click:Connect(function() ScreenGui:Destroy() end)

    MinimizeBtn.Parent = TopBar
    MinimizeBtn.BackgroundColor3 = Color3.fromRGB(200, 100, 50)
    MinimizeBtn.Position = UDim2.new(0.64, 0, 0.15, 0)
    MinimizeBtn.Size = UDim2.new(0, 25, 0, 25)
    MinimizeBtn.Font = Enum.Font.SourceSansBold
    MinimizeBtn.Text = "-"
    MinimizeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    MinimizeBtn.TextSize = 14
    local MinCorner = Instance.new("UICorner")
    MinCorner.CornerRadius = UDim.new(0, 6)
    MinCorner.Parent = MinimizeBtn

    local minimized = false
    MinimizeBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        for _, child in ipairs(MainFrame:GetChildren()) do
            if child ~= TopBar and child ~= UICorner then
                child.Visible = not minimized
            end
        end
        MainFrame.Size = minimized and UDim2.new(0, 220, 0, 35) or UDim2.new(0, 220, 0, 230)
    end)

    -- زر تكبير السكن
    TextButton.Parent = MainFrame
    TextButton.BackgroundColor3 = Color3.fromRGB(210, 40, 40)
    TextButton.Position = UDim2.new(0.1, 0, 0.22, 0)
    TextButton.Size = UDim2.new(0.8, 0, 0, 38)
    TextButton.Font = Enum.Font.SourceSansBold
    TextButton.Text = "تكبير السكن (طول وعرض)"
    TextButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    TextButton.TextSize = 14

    UICornerBtn.CornerRadius = UDim.new(0, 8)
    UICornerBtn.Parent = TextButton

    -- زر إرجاع الجسم طبيعي (المعدل والمضمون)
    ResetBtn.Parent = MainFrame
    ResetBtn.BackgroundColor3 = Color3.fromRGB(190, 80, 20)
    ResetBtn.Position = UDim2.new(0.1, 0, 0.42, 0)
    ResetBtn.Size = UDim2.new(0.8, 0, 0, 38)
    ResetBtn.Font = Enum.Font.SourceSansBold
    ResetBtn.Text = "إرجاع الجسم طبيعي"
    ResetBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    ResetBtn.TextSize = 14

    UICornerReset.CornerRadius = UDim.new(0, 8)
    UICornerReset.Parent = ResetBtn

    -- زر ديسكورد السيرفر
    DiscordBtn.Parent = MainFrame
    DiscordBtn.BackgroundColor3 = Color3.fromRGB(120, 20, 120)
    DiscordBtn.Position = UDim2.new(0.1, 0, 0.62, 0)
    DiscordBtn.Size = UDim2.new(0.8, 0, 0, 38)
    DiscordBtn.Font = Enum.Font.SourceSansBold
    DiscordBtn.Text = "رابط ديسكورد السيرفر"
    DiscordBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    DiscordBtn.TextSize = 14

    UICornerDiscord.CornerRadius = UDim.new(0, 8)
    UICornerDiscord.Parent = DiscordBtn

    DiscordBtn.MouseButton1Click:Connect(function()
        pcall(function() setclipboard(DiscordLink) end)
        DiscordBtn.Text = "تم النسخ!"
        task.wait(1.5)
        DiscordBtn.Text = "رابط ديسكورد السيرفر"
    end)

    -- دالة التكبير
    TextButton.MouseButton1Click:Connect(function()
        local char = LP.Character
        if char then
            pcall(function()
                for _, part in ipairs(char:GetChildren()) do
                    if part:IsA("BasePart") then
                        part.Size = part.Size * 1.5
                    end
                end
            end)
        end
    end)

    -- دالة إرجاع الجسم طبيعي 100% (تعيد تحميل السكن الأصلي فوراً)
    ResetBtn.MouseButton1Click:Connect(function()
        pcall(function()
            local char = LP.Character
            if char then
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                if humanoid then
                    -- إعادة تعيين المقاييس إن وجدت
                    humanoid.BodyDepthScale = 1
                    humanoid.BodyHeightScale = 1
                    humanoid.BodyWidthScale = 1
                    humanoid.HeadScale = 1
                end
                -- الطريقة الأضمن: إجبار اللعبة على إعادة سحب وريست لشكل الشخصية الأصلي
                LP:LoadCharacter()
            end
        end)
    end)
end

-- 3. الاستشعار التلقائي
local hasJoined = false

JoinBtn.MouseButton1Click:Connect(function()
    pcall(function() setclipboard(DiscordLink) end)
    JoinBtn.Text = "تم نسخ الرابط! انضم وارجع للعبة..."
end)

task.spawn(function()
    while not hasJoined do
        task.wait(1.5)
        if JoinBtn.Text:find("تم نسخ") then
            LockStatus.Text = "تم التحقق بنجاح! جاري فتح Panda Hub..."
            LockStatus.TextColor3 = Color3.fromRGB(100, 255, 100)
            task.wait(1)
            hasJoined = true
            LoadMainScript()
            break
        end
    end
end)
